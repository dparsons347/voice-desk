# HighLevel Private Integration Token (Settings > Private Integrations in the sub-account).
# Scopes for M0-M2: voice-ai-dashboard.readonly, voice-ai-agents.readonly,
# voice-ai-agent-goals.readonly, calendars/events.readonly
# For the write tools also: contacts.readonly, conversations/message.write,
# voice-ai-agents.write, voice-ai-agent-goals.write
GHL_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The sub-account (location) the PIT was created in.
GHL_LOCATION_ID=
# Optional overrides
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
# IANA timezone used by the call-logs date filter, e.g. America/Chicago
# GHL_TIMEZONE=
# AUDIT_LOG_PATH=logs/audit.jsonl

# Outcome derivation
# Comma-separated action ids whose firing means the caller asked for a callback.
# Find ids with the get_agent_config tool; it shows how each action is counted.
OUTCOME_CALLBACK_ACTION_IDS=
# ABANDON_THRESHOLD_SECONDS=20
# Your own numbers, so test calls stay out of reports (comma-separated, any format).
EXCLUDE_FROM_NUMBERS=
# Calendars the agent books into. Bookings are confirmed from the calendar because
# HighLevel does not log the booking action on the call. Needs calendars/events.readonly.
BOOKING_CALENDAR_IDS=
# BOOKING_LOOKAHEAD_DAYS=30
# BOOKING_GRACE_SECONDS=60

# Most requests in any 10 seconds. HighLevel allows 100 per app and location; keep headroom.
# RATE_LIMIT_PER_10S=80

# Write tools
# DRY_RUN=true logs and returns writes instead of sending them.
DRY_RUN=false
# SMS_FROM_NUMBER=+15555550100
# SMS_CONSENT_FIELD=SMS Consent On Call
