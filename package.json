{
  "name": "voice-desk",
  "version": "0.1.0",
  "description": "MCP server that audits a HighLevel Voice AI receptionist: finds missed bookings and owed callbacks, and sends follow-ups only after you approve a preview",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "highlevel",
    "gohighlevel",
    "voice-ai",
    "claude"
  ],
  "author": "Daniel Parsons",
  "license": "MIT",
  "type": "module",
  "bin": {
    "voice-desk": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "probe:call-logs": "tsx scripts/probe-call-logs.ts",
    "smoke": "tsx scripts/smoke-stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
